    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.564.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "auth": "^1.7.23",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
