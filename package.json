{
  "name": "30studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --conditions=react-server --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --conditions=react-server --import tsx --test tests/integration/*.test.ts",
    "test:localstack": "node --conditions=react-server --import tsx --test tests/integration/brand-assets-storage.test.ts",
    "maintenance:cleanup-brand-assets": "node --conditions=react-server --import tsx scripts/cleanup-brand-assets.ts",
    "worker:content-media": "node --conditions=react-server --import tsx scripts/content-media-worker.ts",
    "worker:social-publishing": "node --conditions=react-server --import tsx scripts/social-publishing-worker.ts",
    "worker:competitors": "node --conditions=react-server --import tsx scripts/competitor-worker.ts",
    "storage:dev:init": "node --conditions=react-server --import tsx scripts/initialize-local-storage.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:local": "node --conditions=react-server --import tsx scripts/seed-local-user.ts",
    "db:seed:system-owner": "node --conditions=react-server --import tsx scripts/seed-system-owner.ts",
    "db:seed:demo": "node --conditions=react-server --import tsx scripts/seed-local-demo-data.ts",
    "auth:generate": "auth generate --adapter drizzle --dialect postgresql --config lib/db/auth-schema.config.ts --output lib/db/auth-schema.ts --yes"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.143",
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/s3-presigned-post": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "ai": "6.0.330",
    "better-auth": "1.7.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.12.1",
    "lucide-react": "^0.564.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "nodemailer": "10.5.0",
    "oauth4webapi": "^3.8.8",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "24.10.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "auth": "^1.7.23",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
